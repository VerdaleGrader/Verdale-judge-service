# isolate configuration for the development/CI container.
# The entrypoint creates /sys/fs/cgroup/isolate inside the container's
# private cgroup namespace and delegates the controllers to it.
box_root = /var/local/lib/isolate
lock_root = /run/isolate/locks
cg_root = /sys/fs/cgroup/isolate
first_uid = 60000
first_gid = 60000
num_boxes = 1000
