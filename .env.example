# Copy to .env for `docker compose up`. Every value here is for local
# development only; production secrets live in the secret store.

# Redis password (Redis is never reachable from outside the compose network).
REDIS_PASSWORD=local-redis-password-change-me

# core-to-judge keyring that Judge accepts, "kid:secret[,kid2:secret2]".
# Secrets must be at least 32 bytes. Core signs with the same kid/secret.
VERDALE_JUDGE_AUTH_INBOUND_KEYS=core-local:local-core-to-judge-secret-change-me-01

# judge-to-core key Judge signs result callbacks with.
VERDALE_JUDGE_CALLBACK_KEY_ID=judge-local
VERDALE_JUDGE_CALLBACK_SECRET=local-judge-to-core-secret-change-me-01

# Test-file storage. The default is the local driver, which reads
# ./dev/storage (mounted by docker-compose.yml) and needs no settings here.
# To read the same Cloudflare R2 tests bucket Core writes to, uncomment all
# of these. Use a read-only token for Judge; Core needs its own writable one.
# VERDALE_JUDGE_STORAGE_DRIVER=s3
# VERDALE_JUDGE_STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# VERDALE_JUDGE_STORAGE_S3_BUCKET=<tests bucket, same as Core's R2_TESTS_BUCKET>
# VERDALE_JUDGE_STORAGE_S3_ACCESS_KEY_ID=
# VERDALE_JUDGE_STORAGE_S3_SECRET_ACCESS_KEY=

# Log level: debug, info, warn, error.
VERDALE_JUDGE_LOG_LEVEL=info

# Used by `make submit` (cmd/submit) to sign jobs like Core does.
SUBMIT_KEY_ID=core-local
SUBMIT_SECRET=local-core-to-judge-secret-change-me-01

# Used by the mock Core to verify callbacks: the judge-to-core keyring.
MOCKCORE_KEYS=judge-local:local-judge-to-core-secret-change-me-01
# Answer 503 to the first N callbacks to watch Judge retry.
MOCKCORE_FAIL_FIRST=0
